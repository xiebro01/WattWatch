<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>WattWatch.App</RootNamespace>
    <AssemblyName>WattWatch</AssemblyName>
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <StartupObject>WattWatch.App.Program</StartupObject>
    <Version>0.1.0</Version>
    <Company>WattWatch</Company>
    <Product>WattWatch</Product>
    <AssemblyTitle>WattWatch 无线设备电量监控</AssemblyTitle>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\app.ico" Link="assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WattWatch.Core\WattWatch.Core.csproj" />
  </ItemGroup>

</Project>

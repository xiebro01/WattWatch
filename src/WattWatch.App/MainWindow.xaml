<Window x:Class="WattWatch.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WattWatch" Width="420" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        KeyDown="Window_KeyDown">

    <Border CornerRadius="16" Background="{StaticResource BgBrush}" BorderBrush="#252D3B" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- header -->
            <Grid Grid.Row="0" Margin="20,16,14,8" Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="WattWatch" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="无线外设电量 · 低功耗监控" FontSize="11" Margin="0,3,0,0"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE72C;"
                            Command="{Binding RefreshCommand}" ToolTip="立即刷新" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" Margin="2,0"
                            Command="{Binding ToggleSettingsCommand}" ToolTip="设置" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE921;" Margin="2,0"
                            Click="Minimize_Click" ToolTip="最小化" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;"
                            Click="Close_Click" ToolTip="隐藏到托盘" />
                </StackPanel>
            </Grid>

            <!-- devices -->
            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,6,16,10">
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,10"
                                        ToolTip="{Binding Tooltip}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="11"
                                                Background="#1D2431" VerticalAlignment="Center">
                                            <Path Data="{Binding Icon}" Stroke="{Binding Accent}"
                                                  StrokeThickness="1.6" Fill="Transparent"
                                                  Width="23" Height="23" Stretch="Uniform"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,3,0,0"
                                                       Foreground="{StaticResource MutedBrush}" />
                                            <TextBlock Text="{Binding StateText}" FontSize="11" Margin="0,2,0,0"
                                                       Foreground="{StaticResource SubtleBrush}" />
                                            <TextBlock Text="{Binding RemainingText}" FontSize="10.5" Margin="0,2,0,0"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Visibility="{Binding RemainingText, Converter={StaticResource TextToVis}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding PercentText}" FontSize="25" FontWeight="Bold"
                                                           Foreground="{Binding Accent}" />
                                                <TextBlock Text="%" FontSize="11" Margin="2,0,0,4"
                                                           VerticalAlignment="Bottom" Foreground="{Binding Accent}" />
                                            </StackPanel>
                                            <Grid Width="96" Height="4" HorizontalAlignment="Right" Margin="0,5,0,0">
                                                <Border Background="#242B37" CornerRadius="2" />
                                                <Border Background="{Binding Accent}" CornerRadius="2"
                                                        HorizontalAlignment="Left" Width="{Binding BarWidth}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <Path Data="M4,10 L18,10 L18,20 L4,20 Z M18,13 L21,13 L21,17 L18,17"
                          Stroke="{StaticResource MutedBrush}" StrokeThickness="1.5" Fill="Transparent"
                          Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center"
                          StrokeLineJoin="Round" />
                    <TextBlock Text="未发现支持的设备" FontSize="13" Margin="0,14,0,0"
                               Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="请确认 2.4G 接收器已插入，或蓝牙设备已连接" FontSize="11" Margin="0,6,0,0"
                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- footer -->
            <StackPanel Grid.Row="2" Margin="20,6,20,14">
                <TextBlock Text="{Binding StatusLine}" FontSize="11"
                           Foreground="{StaticResource SubtleBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding FooterHint}" FontSize="10" Margin="0,3,0,0"
                           Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- settings overlay -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="{StaticResource BgBrush}" CornerRadius="16"
                    Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                <Grid Margin="20,16,20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}" />
                            <TextBlock Text="省电优先 · 所有读取都在本机完成" FontSize="11" Margin="0,3,0,0"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <Button Style="{StaticResource IconButton}" Content="&#xE72B;" HorizontalAlignment="Right"
                                Command="{Binding ToggleSettingsCommand}" ToolTip="返回" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="后台查询间隔" FontSize="13"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding PollMinutesText}" FontSize="12"
                                                   HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" />
                                    </Grid>
                                    <Slider Style="{StaticResource ThinSlider}" Minimum="5" Maximum="60"
                                            TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,12,0,0"
                                            Value="{Binding PollMinutes, Mode=TwoWay}" />
                                    <TextBlock Text="间隔越长越省电；随时可以点右上角刷新。蓝牙设备读取的是系统缓存，不额外耗电。"
                                               FontSize="10.5" Margin="0,10,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="低电量提醒阈值" FontSize="13"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding ThresholdText}" FontSize="12"
                                                   HorizontalAlignment="Right" Foreground="{StaticResource AccentBrush}" />
                                    </Grid>
                                    <Slider Style="{StaticResource ThinSlider}" Minimum="5" Maximum="50"
                                            TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,12,0,0"
                                            Value="{Binding Threshold, Mode=TwoWay}" />
                                    <TextBlock Text="电量跌破阈值时弹一次通知。" FontSize="10.5" Margin="0,10,0,0"
                                               Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <CheckBox Style="{StaticResource Switch}" Content="开机自动启动"
                                              IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                                    <CheckBox Style="{StaticResource Switch}" Content="关闭窗口时隐藏到托盘"
                                              IsChecked="{Binding CloseToTray, Mode=TwoWay}" Margin="0,16,0,0" />
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource TextButton}" Content="打开数据目录"
                                    Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" />

                            <TextBlock Margin="2,16,2,0" TextWrapping="Wrap" FontSize="10.5" LineHeight="17"
                                       Foreground="{StaticResource MutedBrush}"
                                       Text="WattWatch 只读取设备已经上报的电量：雷蛇与 VGN 走接收器私有协议，蓝牙耳机读取 Windows 已缓存的电量，不会建立 GATT 连接。每次读取都会重新打开并关闭句柄，设备静默时会指数退避而不是反复唤醒。" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
